{
  "name": "poultry-farm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "BASE_URL=/Poultry-Farm/ npm run build && cd dist && git init && git add -A && git commit -m 'Deploy to GitHub Pages' && git branch -M gh-pages && git remote add origin https://github.com/mohammedbakr/Poultry-Farm.git && git push -f origin gh-pages && rm -rf .git"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "i18next": "^24.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "react-router-dom": "^7.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^2.0.0"
  }
